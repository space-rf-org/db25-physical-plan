; DB25 physical planner spec - the versioned IDL (design D1/D7).
;
; The single source of truth for the physical operator catalog and the reference
; execution-capability profile. The planner interprets this spec rather than
; embedding operator knowledge in code; the conformance check (src/spec.cpp)
; asserts the spec and the code agree - every operator the planner can emit is
; declared here, with the arity the IR expects, and marked executable by the
; reference profile. Adding an operator starts by editing this file.
;
; Format: s-expressions (zero-dependency, diffable, the same discipline the rest
; of DB25 already uses). `;` begins a line comment.

(physical-spec
  (version 0)

  ; The physical operator catalog. `arity` is the number of child inputs; `kind`
  ; is a coarse pipeline classification (informational today; the cost model and
  ; property framework consume richer per-operator data in later units).
  (operators
    (operator (name SeqScan)       (arity 0) (kind access-path))
    (operator (name Filter)        (arity 1) (kind pipeline))
    (operator (name Project)       (arity 1) (kind pipeline))
    (operator (name HashJoin)      (arity 2) (kind pipeline-breaker))
    ; MergeJoin requires both inputs sorted on the join keys and preserves that
    ; order on its output - so it is cheaper per row than HashJoin when the order
    ; is already there, and dearer once a Sort must be enforced to get it.
    (operator (name MergeJoin)     (arity 2) (kind pipeline-breaker))
    ; NestedLoopJoin needs no equi-key, which makes it the ONLY legal
    ; implementation of a cross product or a purely non-equi join - and its cost
    ; is quadratic in the inputs, so it never wins where a keyed join applies.
    (operator (name NestedLoopJoin) (arity 2) (kind pipeline-breaker))
    ; Limit passes at most `limit` rows through after discarding `offset` of
    ; them. Order-SENSITIVE: which rows survive depends entirely on the order its
    ; input arrives in, which is why the planner may not push an order
    ; requirement through it.
    (operator (name Limit)         (arity 1) (kind pipeline))
    ; Two implementations of GROUP BY. HashAggregate works on any input and
    ; produces no order; StreamingAggregate needs its input already sorted on the
    ; grouping keys, is cheaper per row, and keeps that order on its output.
    (operator (name HashAggregate)      (arity 1) (kind pipeline-breaker))
    (operator (name StreamingAggregate) (arity 1) (kind pipeline))
    ; Window consumes its input sorted by (PARTITION BY ++ ORDER BY) and appends
    ; one column per window function, emitting in that same order.
    (operator (name Window)             (arity 1) (kind pipeline))
    ; Two implementations of SELECT DISTINCT, the same trade as the aggregates.
    (operator (name HashDistinct)       (arity 1) (kind pipeline-breaker))
    (operator (name StreamingDistinct)  (arity 1) (kind pipeline))
    ; Set operations. UnionAll compares nothing; HashSetOp builds from the right
    ; and probes with the left. They are NOT alternatives for one another -
    ; applicability, not cost, selects between them.
    (operator (name UnionAll)           (arity 2) (kind pipeline))
    (operator (name HashSetOp)          (arity 2) (kind pipeline-breaker))
    ; A literal row set, and the synthetic single row of a FROM-less SELECT.
    (operator (name ValuesScan)         (arity 0) (kind access-path))
    ; Semi and anti joins (EXISTS / IN, NOT EXISTS). Both emit the LEFT schema
    ; only and emit each qualifying left row ONCE however many right rows match,
    ; which is why they are their own operators rather than a join plus a distinct.
    ; Four rather than two with a mode flag: they are exact complements, and an
    ; operator that does not say which it is reads the same as the other.
    (operator (name HashSemiJoin)       (arity 2) (kind pipeline-breaker))
    (operator (name HashAntiJoin)       (arity 2) (kind pipeline-breaker))
    (operator (name NestedLoopSemiJoin) (arity 2) (kind pipeline-breaker))
    (operator (name NestedLoopAntiJoin) (arity 2) (kind pipeline-breaker))
    ; Sort is BOTH the implementation of a logical Sort (ORDER BY) and the
    ; enforcer inserted to establish a required order - one operator, because they
    ; are one operation; only who asked for it differs.
    (operator (name Sort)          (arity 1) (kind pipeline-breaker))
    ; A pure enforcer: inserted to establish a required storage format.
    (operator (name FormatConvert) (arity 1) (kind pipeline)))

  ; Implementation rules: the physical operator each logical operator lowers to.
  ; Increment 0 is single-candidate (one physical op per logical op); a rule set
  ; with alternatives is what the Cascades search will explore in a later unit.
  ; The lowering consults these, so the logical->physical choice is data, not code.
  (implementation-rules
    (rule (logical Scan)    (physical SeqScan))
    (rule (logical Filter)  (physical Filter))
    (rule (logical Project) (physical Project))
    ; Two candidates for a join: the planner costs both - including any enforcers
    ; each would cause - and keeps the cheaper.
    (rule (logical Join)    (physical HashJoin))
    (rule (logical Join)    (physical MergeJoin))
    ; The keyless fallback. Applicability (not cost) is what selects it: the two
    ; keyed joins are not applicable without an equi-key.
    (rule (logical Join)    (physical NestedLoopJoin))
    ; Single-candidate for now. A TopN that fuses a Limit over a Sort is the
    ; obvious second candidate and is deliberately absent: it fuses TWO logical
    ; nodes into one physical operator, which needs a transformation rule, and the
    ; memo is still one group per logical node. Adding TopN as an implementation
    ; rule for either node alone would be wrong.
    (rule (logical Sort)    (physical Sort))
    (rule (logical Limit)   (physical Limit))
    (rule (logical Aggregate) (physical HashAggregate))
    (rule (logical Aggregate) (physical StreamingAggregate))
    (rule (logical Window)    (physical Window))
    (rule (logical Distinct)  (physical HashDistinct))
    (rule (logical Distinct)  (physical StreamingDistinct))
    (rule (logical SetOp)     (physical UnionAll))
    (rule (logical SetOp)     (physical HashSetOp))
    (rule (logical Values)    (physical ValuesScan))
    (rule (logical SemiJoin)  (physical HashSemiJoin))
    (rule (logical SemiJoin)  (physical NestedLoopSemiJoin))
    (rule (logical AntiJoin)  (physical HashAntiJoin))
    (rule (logical AntiJoin)  (physical NestedLoopAntiJoin)))

  ; Where exhaustive search stops being affordable (design D5). Past this many
  ; joins the planner falls back to a bounded enumeration - a worse plan chosen by
  ; the SAME cost model, rather than a better plan that arrives too late.
  ;
  ; The number here is a placeholder, not a derived value. Deriving it from the
  ; planning-time budget is open question 5; what is settled is that it lives in
  ; the spec rather than in a source file, so it can be tuned per profile without
  ; a rebuild.
  (search-budget (max-join-count 8))

  ; The reference ExecutionCapabilityProfile: what a competent hardware-native
  ; engine is assumed able to execute. It ships now so the planner is usable and
  ; testable before any execution engine exists; a real engine later publishes
  ; its own profile in this same shape.
  (capability-profile
    (name reference)
    (executes SeqScan Filter Project HashJoin MergeJoin NestedLoopJoin
              Sort FormatConvert Limit HashAggregate StreamingAggregate Window
              HashDistinct StreamingDistinct UnionAll HashSetOp ValuesScan
              HashSemiJoin HashAntiJoin NestedLoopSemiJoin NestedLoopAntiJoin)))
