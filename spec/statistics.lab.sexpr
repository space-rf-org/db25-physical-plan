; Lab statistics for the tests, matching the benchmark fixture in the umbrella's
; docs/bench. Checked in for the reason the lab calibration profile is: a test
; that asserts an estimate needs numbers somebody can review, not numbers the
; test invented inline.
;
; Ids are the catalog's, not names. emp is table 1 with columns id=1, name=2,
; dept_id=3, salary=4.
(statistics
  (table (id 1) (rows 20000)
    (column (id 1) (ndv 20000) (nulls 0.0) (min 1) (max 20000) (unique true))
    (column (id 2) (ndv 20000) (nulls 0.0))
    (column (id 3) (ndv 50)    (nulls 0.0) (min 0) (max 49))
    (column (id 4) (ndv 20000) (nulls 0.0) (min 0) (max 19999)))
  (table (id 2) (rows 50)
    (column (id 1) (ndv 50) (nulls 0.0) (min 1) (max 50) (unique true))
    (column (id 2) (ndv 50) (nulls 0.0))))
